
<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="Final_project.admin.Admin" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server">
                <!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin System Control - SecurePaper</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="../assets/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

<div class="sp-app-layout">
  
  <aside class="sp-sidebar">
    <div class="sp-sidebar-brand">
      <div class="sp-brand-icon"><i class="bi bi-shield-lock-fill"></i></div>
      <span>SecurePaper</span>
    </div>
    
    <div class="sp-sidebar-menu">
      <div class="sp-sidebar-header">Admin Navigation</div>
      <div class="sp-nav-item"><a href="dashboard.aspx" class="sp-nav-link active"><i class="bi bi-speedometer2"></i> System Control</a></div>
    
      <div class="sp-sidebar-header">User & Entity Management</div>
      <div class="sp-nav-item"><a href="manage-faculty.aspx" class="sp-nav-link"><i class="bi bi-person-badge"></i> Manage Faculty</a></div>
      <div class="sp-nav-item"><a href="manage-students.aspx" class="sp-nav-link"><i class="bi bi-mortarboard"></i> Manage Students</a></div>
      <div class="sp-nav-item"><a href="manage-evaluators.aspx" class="sp-nav-link"><i class="bi bi-pencil-square"></i> Manage Evaluators</a></div>
      <div class="sp-nav-item"><a href="manage-departments.aspx" class="sp-nav-link"><i class="bi bi-building"></i> Departments</a></div>
      <div class="sp-nav-item"><a href="manage-subjects.aspx" class="sp-nav-link"><i class="bi bi-journal-text"></i> Subjects</a></div>
    
      <div class="sp-sidebar-header">Exams & Governance</div>
      <div class="sp-nav-item"><a href="manage-exams.aspx" class="sp-nav-link"><i class="bi bi-card-checklist"></i> Manage Exams</a></div>
      <div class="sp-nav-item"><a href="publish-results.aspx" class="sp-nav-link"><i class="bi bi-trophy"></i> Publish Results</a></div>
    
      <div class="sp-sidebar-header">System</div>
      <div class="sp-nav-item"><a href="system-settings.aspx" class="sp-nav-link"><i class="bi bi-sliders"></i> System Settings</a></div>
      <div class="sp-nav-item"><a href="logs.aspx" class="sp-nav-link"><i class="bi bi-receipt"></i> System Logs</a></div>
    </div>

    <div class="sp-sidebar-footer">
      <a href="../login-selection.aspx" class="sp-nav-link text-danger"><i class="bi bi-box-arrow-right"></i> Logout</a>
    </div>
  </aside>

</asp:ContentPlaceHolder>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder3" runat="server">
                 <div class="sp-main-wrapper">
   <header class="sp-navbar">
     <div class="d-flex align-items-center gap-3">
       <button class="btn btn-sm btn-light d-lg-none sp-sidebar-toggler"><i class="bi bi-list fs-5"></i></button>
       <div class="sp-nav-search">
           <i class="bi bi-search"></i>
           <%-- ASP.NET Search TextBox --%>
           <asp:TextBox ID="txtSearch" runat="server" placeholder="Search system entities, logs..."></asp:TextBox>
       </div>
     </div>

     <div class="sp-navbar-right">
       <button class="sp-icon-btn sp-theme-toggle"><i class="bi bi-moon-stars-fill"></i></button>
       <div class="sp-user-profile">
         <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=120&q=80" class="sp-avatar">
         <div class="sp-user-info d-none d-md-block">
           <span class="sp-user-name">Dr. Arthur Pendelton</span>
           <span class="sp-user-role">Exam Controller</span>
         </div>
       </div>
     </div>
   </header>

   <div class="sp-page-header">
     <div>
       <h1 class="sp-page-title">Admin Control Dashboard</h1>
       <nav aria-label="breadcrumb">
         <ol class="breadcrumb">
           <li class="breadcrumb-item"><a href="../index.html">Home</a></li>
           <li class="breadcrumb-item"><a href="#">Admin</a></li>
           <li class="breadcrumb-item active">Dashboard</li>
         </ol>
       </nav>
     </div>
     <div class="d-flex gap-2">
       <a href="publish-results.html" class="btn btn-danger font-semibold px-4"><i class="bi bi-megaphone-fill me-1"></i> Publish Results Engine</a>
     </div>
   </div>

   <div class="sp-content">
    
     <!-- Admin 8 Stat Cards Grid -->
     <div class="row g-3 mb-4">
       <div class="col-sm-6 col-xl-3">
         <div class="sp-stat-card">
           <div class="sp-stat-icon success"><i class="bi bi-mortarboard-fill"></i></div>
           <div class="sp-stat-details">
             <h3>1,240</h3>
             <p>Total Students</p>
           </div>
         </div>
       </div>
       <div class="col-sm-6 col-xl-3">
         <div class="sp-stat-card">
           <div class="sp-stat-icon primary"><i class="bi bi-person-badge-fill"></i></div>
           <div class="sp-stat-details">
             <h3>84</h3>
             <p>Total Faculty</p>
           </div>
         </div>
       </div>
       <div class="col-sm-6 col-xl-3">
         <div class="sp-stat-card">
           <div class="sp-stat-icon warning"><i class="bi bi-pencil-square"></i></div>
           <div class="sp-stat-details">
             <h3>28</h3>
             <p>Total Evaluators</p>
           </div>
         </div>
       </div>
       <div class="col-sm-6 col-xl-3">
         <div class="sp-stat-card">
           <div class="sp-stat-icon info"><i class="bi bi-building-fill"></i></div>
           <div class="sp-stat-details">
             <h3>7</h3>
             <p>Total Departments</p>
           </div>
         </div>
       </div>

       <div class="col-sm-6 col-xl-3">
         <div class="sp-stat-card">
           <div class="sp-stat-icon secondary"><i class="bi bi-journal-text"></i></div>
           <div class="sp-stat-details">
             <h3>46</h3>
             <p>Total Subjects</p>
           </div>
         </div>
       </div>
       <div class="col-sm-6 col-xl-3">
         <div class="sp-stat-card">
           <div class="sp-stat-icon danger"><i class="bi bi-file-earmark-check-fill"></i></div>
           <div class="sp-stat-details">
             <h3>128</h3>
             <p>Exams Conducted</p>
           </div>
         </div>
       </div>
       <div class="col-sm-6 col-xl-3">
         <div class="sp-stat-card">
           <div class="sp-stat-icon success"><i class="bi bi-trophy-fill"></i></div>
           <div class="sp-stat-details">
             <h3>12</h3>
             <p>Result Publications</p>
           </div>
         </div>
       </div>
       <div class="col-sm-6 col-xl-3">
         <div class="sp-stat-card">
           <div class="sp-stat-icon primary"><i class="bi bi-cpu-fill"></i></div>
           <div class="sp-stat-details">
             <h3 class="text-success">100%</h3>
             <p>Server Status</p>
           </div>
         </div>
       </div>
     </div>

     <!-- Admin Overview Bar Chart -->
     <div class="row g-4 mb-4">
       <div class="col-lg-12">
         <div class="card p-3">
           <div class="card-header border-0 bg-transparent">
             <h5 class="fw-bold mb-0"><i class="bi bi-bar-chart-fill text-danger me-2"></i> Department-Wise Student & Faculty Distribution</h5>
           </div>
           <div class="card-body">
             <canvas id="adminOverviewChart" height="120"></canvas>
           </div>
         </div>
       </div>
     </div>

   </div>
 </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="../assets/js/main.js"></script>
<script src="../assets/js/charts.js"></script>
</body>
</html>

</asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
